<Project Sdk="Microsoft.NET.Sdk">

  <!-- 用主程式的 DngConverter 轉真實 DNG，檢查轉檔方式、拍攝資訊與 XMP。
       用法：RawConvertCheck.exe <輸出資料夾> <DNG> ... -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Photo2Disk.RawConvertCheck</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Photo2Disk\DedupEngine.cs" Link="Engine\DedupEngine.cs" />
    <Compile Include="..\..\Photo2Disk\BackupSettingsFile.cs" Link="Engine\BackupSettingsFile.cs" />
    <Compile Include="..\..\Photo2Disk\HashIndex.cs" Link="Engine\HashIndex.cs" />
    <Compile Include="..\..\Photo2Disk\ImportHistory.cs" Link="Engine\ImportHistory.cs" />
    <Compile Include="..\..\Photo2Disk\MediaMetadata.cs" Link="Engine\MediaMetadata.cs" />
    <Compile Include="..\..\Photo2Disk\Naming.cs" Link="Engine\Naming.cs" />
    <Compile Include="..\..\Photo2Disk\DngExif.cs" Link="Engine\DngExif.cs" />
    <Compile Include="..\..\Photo2Disk\DngConverter.cs" Link="Engine\DngConverter.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Sdcb.LibRaw" Version="0.21.1.7" />
    <PackageReference Include="Sdcb.LibRaw.runtime.win64" Version="0.21.1" />
  </ItemGroup>

</Project>
